{
  "name": "sea-traces-js",
  "version": "5.5.0-beta.2",
  "description": "Sea Traces JavaScript / TypeScript SDK",
  "author": "Sea Traces",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check:format": "prettier --check \"**/*.{ts,js,json,md}\" --log-level error --experimental-cli",
    "check:lint": "eslint \"packages/*/src/**/*.ts\" --quiet",
    "check:type": "tsc -b --noEmit",
    "precommit:check": "turbo run check:lint check:type check:format --continue=never",
    "docs": "pnpm build && typedoc --options ./typedoc.config.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm run build && vitest run --project=integration",
    "test:integration:watch": "pnpm run build && vitest --project=integration",
    "test:e2e": "pnpm run build && vitest run --project=e2e",
    "lint": "eslint \"packages/*/src/**/*.ts\" --quiet",
    "lint:fix": "eslint \"packages/*/src/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\" --experimental-cli",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\" --log-level error --experimental-cli",
    "typecheck": "tsc -b --noEmit",
    "release": "tag=latest release-it",
    "release:alpha": "tag=alpha release-it --preRelease=alpha",
    "release:beta": "tag=beta release-it --preRelease=beta",
    "release:rc": "tag=rc release-it --preRelease=rc",
    "release:dry": "tag=latest release-it --dry-run",
    "ci": "pnpm build && pnpm test && pnpm lint && pnpm typecheck && pnpm format:check",
    "clean": "pnpm -r run clean && rm -rf packages/*/dist && rm -f packages/*/tsconfig.tsbuildinfo",
    "nuke": "pnpm clean && rm -rf node_modules && rm -rf packages/*/node_modules && pnpm install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4",
    "@ai-sdk/openai": "^4",
    "@eslint/js": "^9.39.5",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.2.8",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@release-it/bumper": "^8.0.0",
    "@types/mustache": "^4.2.6",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.65.0",
    "ai": "^7",
    "autoevals": "^0.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "mustache": "^4.2.0",
    "nanoid": "^5.1.5",
    "openai": "^6.49.0",
    "prettier": "^3.9.6",
    "release-it": "^20.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typedoc": "^0.28.20",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "resolutions": {
    "ml-spectra-processing": "14.14.0"
  },
  "packageManager": "pnpm@10.33.0"
}
